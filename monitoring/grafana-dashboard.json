{
  "dashboard": {
    "id": null,
    "title": "SafeHabitat AI Dashboard",
    "tags": ["safehabitat", "disaster", "ai"],
    "timezone": "Asia/Kolkata",
    "panels": [
      {
        "title": "API Requests",
        "type": "graph",
        "targets": [{"expr": "rate(safehabitat_requests_total[5m])"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "title": "Request Latency",
        "type": "graph",
        "targets": [{"expr": "histogram_quantile(0.95, rate(safehabitat_request_latency_seconds_bucket[5m]))"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "title": "Model Predictions",
        "type": "graph",
        "targets": [{"expr": "rate(safehabitat_model_predictions_total[5m])"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "title": "Model Accuracy",
        "type": "stat",
        "targets": [{"expr": "safehabitat_model_accuracy"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "title": "Risk Distribution",
        "type": "piechart",
        "targets": [{"expr": "safehabitat_risk_distribution"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "title": "Data Freshness",
        "type": "stat",
        "targets": [{"expr": "safehabitat_data_freshness_hours"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "title": "Alerts",
        "type": "graph",
        "targets": [{"expr": "rate(safehabitat_alerts_fired_total[5m])"}],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "time": {"from": "now-6h", "to": "now"},
    "refresh": "30s"
  }
}
